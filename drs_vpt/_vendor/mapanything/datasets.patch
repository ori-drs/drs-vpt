+LIDAR_KEYS = {"coord", "normal", "color", "grid_size", "scene_scale"}
+from torch.utils.data import default_collate
+
+def collate_points_and_images(samples):
+
+    drop = lambda d: {k: v for k, v in d.items() if k not in LIDAR_KEYS}
+    collated_inputs = default_collate([[drop(d) for d in l] for l in samples])
+
+    point_transform = sonata.transform.default()
+    point_collate_fn = sonata.data.collate_fn
+
+    lidar_samples = dict()
+    for b_id, b in enumerate(samples):
+        for v_id, view in enumerate(b):
+            if v_id not in lidar_samples:
+                lidar_samples[v_id] = dict()
+            lidar_samples[v_id][b_id] = point_transform({k:view[k] for k in LIDAR_KEYS})
+
